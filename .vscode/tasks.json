{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "shell",
      "command": "source $HOME/.nvm/nvm.sh && nvm use 24 > /dev/null && npm run compile",
      "options": {
        "shell": {
          "executable": "/usr/bin/bash",
          "args": ["-lc"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc",
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
